function segmentsCross(a,b,c,d){function side(p,q,r){return (q.x-p.x)*(r.y-p.y)-(q.y-p.y)*(r.x-p.x)}return side(a,b,c)*side(a,b,d)<0&&side(c,d,a)*side(c,d,b)<0}
