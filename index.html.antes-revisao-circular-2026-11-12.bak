 }shown=steps.length;
};
function physicsStep(){var sim=steps.filter(function(s){return !isFolded(s)&&(!physics.overview||s.kind==='user')}),n=sim.length;if(!n)return;physics.spacing=(physics.spacing||1)+((physics.targetSpacing||physics.spacing||1)-(physics.spacing||1))*.08;var heat=Math.max(.005,physics.heat),spacing=physics.spacing||1,repel=physics.repel*32*spacing*spacing;
