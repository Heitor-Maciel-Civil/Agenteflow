 var visible=new Set(),margin=180/Math.max(.1,sc),left=-tx/sc-margin,top=-ty/sc-margin,right=(cv.clientWidth-tx)/sc+margin,bottom=(cv.clientHeight-ty)/sc+margin;
 steps.forEach(function(s){s.size=nodeSize(s);s.x=s.cx-s.size/2;s.y=s.cy-s.size/2;var show=!isFolded(s)&&(!physics.overview||s.kind==='user')&&(!focused||s.turn===focused.turn)&&s.cx>=left&&s.cx<=right&&s.cy>=top&&s.cy<=bottom;
