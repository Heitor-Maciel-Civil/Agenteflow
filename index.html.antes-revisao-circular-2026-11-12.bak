  var labelSpace=sc>=1.75?19:sc>=.85?9:0;
  var min=((a.size+b.size)/2+(separate?170:prominent?260:unrelated?180:((a.size>30||b.size>30)?80:38))+labelSpace)*spacing,force=repel*(prominent?5:1)/Math.max(d*d,100)+Math.max(0,min-d)*.09;
