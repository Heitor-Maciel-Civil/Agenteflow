}
var oldPaintSel=paintSel;paintSel=function(){oldPaintSel();drawGraph()};
document.getElementById('forcesToggle').onclick=function(){var p=document.getElementById('forces');p.hidden=!p.hidden;this.setAttribute('aria-expanded',String(!p.hidden))};
[['centerForce','center','centerValue'],['repelForce','repel','repelValue'],['linkForce','link','linkValue'],['linkDistance','distance','distanceValue']].forEach(function(c){var input=document.getElementById(c[0]),output=document.getElementById(c[2]);output.value=input.value;input.oninput=function(){physics[c[1]]=+input.value;output.value=input.value;reheat()}});
document.getElementById('pausePhysics').onclick=function(){physics.paused=!physics.paused;this.textContent=physics.paused?'Retomar movimento':'Pausar movimento';reheat()};
document.getElementById('resetPhysics').onclick=function(){[['centerForce',35],['repelForce',45],['linkForce',55],['linkDistance',90]].forEach(function(c){var e=document.getElementById(c[0]);e.value=c[1];e.oninput()});steps.forEach(function(s){s.pinned=false});reheat()};
