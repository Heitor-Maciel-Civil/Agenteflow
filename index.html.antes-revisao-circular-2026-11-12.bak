};
function importance(s){if(s.kind==='user'||s.sat==='err'||s.kind==='edit')return 3;
  if(s.kind==='file')return s.resourceImage?2:1;
  if(s.kind==='ans')return s.channel==='final'?3:2;
  if(/apply_patch|write|create|test|build|pytest|npm run/i.test(s.name+' '+s.cmd))return 2;
  if(s.kind==='img')return 2;
  if(s.kind==='think'||/getAXState|getScreenshot|Get-Content|Get-Item|list|search|read|wait|poll/i.test(s.name+' '+s.cmd))return 0;
  return 1}
function requestState(s){var actions=steps.filter(function(a){return a.turn===s.turn&&a.sat});return s.turnComplete&&!s.turnAborted&&!actions.some(function(a){return a.sat==='pending'||a.sat==='err'})?'ok':'pending'}
function nodeState(s){if(s.kind==='user')return requestState(s);if(s.sat)return s.sat;if(s.kind==='ans'&&s.channel==='final')return 'ok';return 'neutral'}
function nodeLevel(s){var level=importance(s);if(s.kind==='think'&&(!s.parent||s.parent.kind!=='think'))level=2;if(s.kind==='tool'){if(s.parent&&s.parent.kind!=='tool')level=Math.max(2,level);else if(level<2)level=0}if(typeof physics!=='undefined'&&physics&&s===physics.processing)level=Math.max(1,level);return level}
function nodeSize(s){var level=nodeLevel(s);return level===0&&sc>=1.75?28:[12,32,56,84][level]}
function actionSummary(s){if(s.kind==='edit')return 'Alterou arquivos do projeto.';if(s.kind==='web')return 'Buscou informações na internet.';if(s.kind==='img')return 'Abriu uma imagem para conferência.';var text=(s.name||'')+' '+(s.cmd||'');if(/apply_patch/.test(text))return 'Aplicou alterações nos arquivos.';if(/test|assert|pytest|valid|node --check/i.test(text))return 'Executou uma verificação.';if(/Get-Content|readFile|read_file|\bread\b/i.test(text))return 'Leu arquivos para consultar informações.';if(/\brg\b|search|Get-ChildItem|list_/i.test(text))return 'Procurou arquivos ou informações.';if(/view_image|screenshot|Screenshot/.test(text))return 'Conferiu uma imagem ou a tela.';if(/build|compile|compil|npm run/i.test(text))return 'Preparou ou compilou o projeto.';if(/fetch|http|Invoke-WebRequest/.test(text))return 'Consultou um serviço para obter informações.';return 'Executou uma etapa da tarefa.'}
function resultSummary(s){var state=nodeState(s),text=String(s.out||''),j=parse(text);if(state==='pending')return 'Em andamento; ainda sem resultado final.';if(state==='err'){if(/not found|não.*encontr|ENOENT/i.test(text))return 'Não foi possível encontrar um arquivo ou recurso necessário.';if(/denied|EACCES|permiss/i.test(text))return 'A etapa falhou por falta de acesso ou permissão.';if(/timeout|timed out|prazo/i.test(text))return 'A etapa não respondeu dentro do prazo.';return 'Foi registrada uma falha nesta etapa.'}if(state==='ok'||s.out!=null){if(/^(?:PASS\b|\s*\d+ passed\b|HTTP (?:200|OK)\b)/im.test(text))return 'Concluído; a verificação registrada passou.';if(j&&Array.isArray(j)&&!j.length)return 'Concluído; nenhum item foi encontrado.';return 'Etapa concluída sem erro registrado.'}return 'Nenhum resultado foi registrado para esta etapa.'}
function activitySummary(s){var index=steps.indexOf(s),action=null;for(var i=index+1;i<steps.length;i++){var next=steps[i];if(next.turn!==s.turn||next.kind==='user'||next.kind==='think')break;if(next.agentOwner!==s.agentOwner)continue;if(/^(tool|edit|web|img|ans)$/.test(next.kind)){action=next;break}}if(!action)return 'Organizando a próxima etapa. O texto interno do raciocínio não foi registrado.';if(action.kind==='edit')return 'Preparando uma alteração nos arquivos.';if(action.kind==='web')return 'Buscando informações para a tarefa.';if(action.kind==='img')return 'Conferindo uma imagem.';if(action.kind==='ans')return 'Preparando uma resposta.';var text=(action.name||'')+' '+(action.cmd||'');if(/test|assert|check|valid|pytest/i.test(text))return 'Conferindo o resultado e verificando possíveis problemas.';if(/Get-Content|read|search|rg\b|Get-ChildItem|list/i.test(text))return 'Consultando arquivos e informações da tarefa.';return 'Executando uma etapa da tarefa.'}
paint=function(s){originalPaint(s);var state=nodeState(s),level=nodeLevel(s);s.size=nodeSize(s);
  if(s.kind==='img'||s.kind==='file'&&s.resourceImage){s.el.style.backgroundImage='';s.el.firstChild.style.display=''}
  s.el.className='n '+s.kind+(level===0?' minor':level===3?' major':'')+(s===selected?' sel':'');
  if(s.kind==='user')s.el.querySelector('.lb b').textContent=s.subrequestOf?'Subpedido '+(s.subrequestOf.turn+1)+'.'+s.subrequestNumber:'Pedido '+(s.turn+1);
  s.el.style.setProperty('--size',s.size+'px');  s.el.style.setProperty('--state',s.kind==='user'?(state==='ok'?'#e4e4e4':'#888888'):importanceTone(nodeLevel(s)));
  s.el.style.setProperty('--orbit-outset',orbitOutset(s)+'px');
  if(s.kind==='agent')s.el.style.setProperty('--agent-color',agentColor(s));
  if(s.kind==='agent')s.el.querySelector('.lb b').textContent=agentAssignment(s);
  if(s.kind==='think')s.subEl.textContent=activitySummary(s);
  if(s.kind==='file'){s.el.querySelector('.lb b').textContent=base(s.resourcePath);s.subEl.textContent=s.resourceImage?'Imagem':s.resourceDiff?'Alteração de arquivo':'Arquivo consultado'}
  if(/^(tool|edit|web|img)$/.test(s.kind))s.subEl.textContent=actionSummary(s)+' '+resultSummary(s);
  var label=({ok:'Conclusão registrada',pending:'Em execução ou incompleto',err:'Falha',neutral:'Sem conclusão registrada'})[state];
  s.el.title=(s.kind==='agent'?agentAssignment(s):K[s.kind].t)+' · '+label+'\n'+(s.kind==='think'?activitySummary(s):/^(tool|edit|web|img)$/.test(s.kind)?actionSummary(s)+' '+resultSummary(s):s.sub||s.name||'');s.el.setAttribute('aria-label',s.el.title);s.el.tabIndex=0;s.el.setAttribute('role','button');
  s.el.onkeydown=function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();s.el.click()}};
  if(!s.badge){s.badge=el('small','badge');s.el.appendChild(s.badge)}s.badge.textContent=state==='ok'?'✓':'';s.badge.style.display=state==='ok'?'':'none';
};
focus=function(s){sc=Math.min(sc,1)||1;tx=cv.clientWidth*.5-s.cx*sc;ty=cv.clientHeight*.5-s.cy*sc;applyT(true)};
fit=function(){if(!steps.length)return;var x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;
 var visible=steps.filter(function(s){return !isFolded(s)&&(sc>=.35||s.kind==='user')});if(historyView.folded&&historyView.anchor)visible.push(historyView.anchor);
 visible.forEach(function(s){x0=Math.min(x0,s.x-90);y0=Math.min(y0,s.y-30);x1=Math.max(x1,s.x+s.size+90);y1=Math.max(y1,s.y+s.size+65)});
 sc=Math.min(1,(cv.clientWidth-80)/(x1-x0),(cv.clientHeight-100)/(y1-y0));tx=(cv.clientWidth-(x1-x0)*sc)/2-x0*sc;ty=(cv.clientHeight-(y1-y0)*sc)/2-y0*sc;applyT(true)};
render=function(){dirty=false;var groups={},edges=[],d='';steps.forEach(function(s){(groups[s.turn]||(groups[s.turn]=[])).push(s)});
 Object.keys(groups).forEach(function(key,gi){var list=groups[key],root=list.find(function(s){return s.kind==='user'})||list[0],ox=(gi%3)*1050,oy=Math.floor(gi/3)*1050;
  root.cx=ox;root.cy=oy;var buckets=[[],[],[],[]];list.forEach(function(s){if(s!==root)buckets[s.kind==='edit'?0:s.kind==='ans'?1:s.kind==='think'?2:3].push(s)});
  buckets.forEach(function(bucket,bi){var hub=null;bucket.forEach(function(s,i){var ring=Math.floor(i/4),slot=i%4,angle=bi*Math.PI/2-Math.PI*.8+(slot/4)*Math.PI*.48,r=210+ring*125;
    s.cx=ox+Math.cos(angle)*r;s.cy=oy+Math.sin(angle)*r;
    if(i===0){hub=s;edges.push([root,s])}else edges.push([hub,s]);
  })});if(gi>0){var prior=groups[Object.keys(groups)[gi-1]];edges.push([prior.find(function(s){return s.kind==='user'})||prior[0],root])}
 });
 steps.forEach(function(s){ensure(s);paint(s);s.x=s.cx-s.size/2;s.y=s.cy-s.size/2;s.el.style.left=s.x+'px';s.el.style.top=s.y+'px'});
 edges.forEach(function(e){d+='<path class="w" d="M'+e[0].cx+','+e[0].cy+' L'+e[1].cx+','+e[1].cy+'"/>'});wg.innerHTML=d;
 var last=steps[steps.length-1];ghost.style.display=working&&last?'flex':'none';if(last){ghost.style.left=(last.cx+60)+'px';ghost.style.top=last.cy+'px'}
 document.getElementById('empty').style.display=steps.length?'none':'flex';info();setStatus(working);
 if(steps.length>shown&&follow.checked&&last){if(shown===0)fit();else if(importance(last)>0)focus(last)}shown=steps.length;
};
var activeSessionId=null,agentLoadBusy=false;
var originalHandle=handle;handle=function(o){originalHandle(o);var p=o.payload||{};
 if(o.type==='session_meta')activeSessionId=p.id||p.session_id;
 if(o.type==='response_item'&&p.type==='message'&&p.role==='assistant'&&steps.length)steps[steps.length-1].channel=p.channel;
 if(o.type==='event_msg'&&(p.type==='task_complete'||p.type==='turn_aborted')){var root=steps.slice().reverse().find(function(s){return s.kind==='user'});if(root){var main=root.subrequestOf||root;steps.filter(function(s){return s===main||s.subrequestOf===main}).forEach(function(s){s.turnComplete=p.type==='task_complete';s.turnAborted=p.type==='turn_aborted'});dirty=true}}
 if(o.type==='event_msg'&&p.item&&p.item.type==='SubAgentActivity'){var item=p.item,path=item.agent_path,agent=steps.find(function(s){return s.kind==='agent'&&s.agentPath===path});
  if(!agent){agent=add('agent',base(path),'Agente: '+path,o.timestamp,{agentPath:path,assignment:item.task_name||item.agent_name||item.title,sat:'pending',satTxt:'em execução'})}
  if(item.kind==='completed'){agent.sat='ok';agent.satTxt='concluído'}dirty=true;
 }
 if(o.type==='response_item'&&p.type==='agent_message'){var author=p.author,agent=steps.find(function(s){return s.kind==='agent'&&s.agentPath===author}),body=(p.content||[]).map(function(c){return c.text||''}).join('\n');
  if(agent&&body){var reply=add('ans','Resposta de '+base(author),body,o.timestamp,{agentOwner:agent,channel:'final'});reply.turn=agent.turn;agent.detail=body;agent.sat='ok';agent.satTxt='resposta recebida'}
 }
};
K.agent={t:'Agente paralelo',i:'>_',c:'#d0d0d0'};
K.file={t:'Arquivo',i:'▤',c:'#b8b8b8'};
function agentAssignment(s){var name=s.assignment||base(s.agentPath||s.name||'Agente');return name.replace(/[_-]+/g,' ').replace(/^./,function(c){return c.toUpperCase()})}
var baseImportance=importance;importance=function(s){return s.kind==='agent'?3:baseImportance(s)};
async function loadAgentCommands(){if(document.hidden||agentLoadBusy||!activeSessionId)return;agentLoadBusy=true;var session=activeSessionId;
 try{for(var agent of steps.filter(function(s){return s.kind==='agent'})){
  if(agent.logsComplete)continue;var response=await fetch('/api/agent?parent='+encodeURIComponent(session)+'&agent='+encodeURIComponent(agent.agentPath)+'&after='+(agent.logCursor||0)+'&own='+(agent.logOwn||'0'));if(!response.ok)continue;var records=await response.json();if(session!==activeSessionId)return;
  agent.logCursor=Number(response.headers.get('X-Flow-Cursor'))||0;agent.logOwn=response.headers.get('X-Flow-Own')||'0';agent.logFile=response.headers.get('X-Flow-File')||agent.logFile;
  for(var record of records){var p=record.payload,start=steps.length;
   if(/_output$/.test(p.type))out(p);else if(/_call$/.test(p.type))call(p,record.timestamp);else if(p.type==='reasoning')add('think','Raciocínio do subagente',(p.summary||[]).map(function(s){return s.text||''}).join('\n'),record.timestamp);
   for(var i=start;i<steps.length;i++){steps[i].turn=agent.turn;steps[i].agentOwner=agent}
  }if(agent.sat==='ok'&&response.headers.get('X-Flow-Caught-Up')==='true')agent.logsComplete=true;
 }}finally{agentLoadBusy=false}
}
setInterval(function(){loadAgentCommands().catch(function(){})},2500);
// Simulação de molas, repulsão e colisão. As posições sobrevivem a novos eventos.
var physics={center:35,repel:45,link:55,distance:90,paused:false,heat:1,edges:[],hover:null,drag:null,frame:0,fitPending:false};
var oldReset=resetAll;resetAll=function(){oldReset();physics.edges=[];physics.heat=1;physics.fitPending=true;physics.hover=null;physics.drag=null;physics.focusedRequest=null};
function reheat(level){physics.heat=level==null?1:Math.max(physics.heat,level);physics.settlePass=0;physics.quietFrames=0}
function graphEdges(){var groups={},edges=[],previous=null;steps.forEach(function(s){(groups[s.turn]||(groups[s.turn]=[])).push(s)});
 Object.keys(groups).forEach(function(key){var list=groups[key],root=list.find(function(s){return s.kind==='user'})||list[0],hubs={};
  if(root.subrequestOf)edges.push({a:root.subrequestOf,b:root,subrequest:true});else{if(previous)edges.push({a:previous,b:root,root:true});previous=root;}
  root.treeRoot=root;list.forEach(function(s){if(s===root)return;s.treeRoot=root;
   if(s.resourceOf){s.parent=s.resourceOf;edges.push({a:s,b:s.resourceOf,resource:true});return}
   if(s.kind==='agent'||s.agentOwner){s.parent=s.agentOwner||root;edges.push({a:s.parent,b:s});return}
   var category=s.kind==='edit'?'edit':s.kind==='ans'?'ans':s.kind==='think'?'think':'tool',hub=hubs[category];
   s.parent=hub||root;edges.push({a:s.parent,b:s});if(!hub)hubs[category]=s;
  });
 });return edges}
function installInteraction(s){if(s.interactive)return;s.interactive=true;
 s.el.addEventListener('pointerdown',function(e){if(e.button!==0)return;e.stopPropagation();follow.checked=false;
  var startX=e.clientX,startY=e.clientY,ox=s.cx,oy=s.cy,moved=false,wasPinned=s.pinned;s.dragging=true;physics.drag=s;reheat();s.el.setPointerCapture(e.pointerId);
  function move(m){if(Math.hypot(m.clientX-startX,m.clientY-startY)>4)moved=true;if(!moved)return;s.cx=ox+(m.clientX-startX)/sc;s.cy=oy+(m.clientY-startY)/sc;s.vx=s.vy=0;reheat();drawGraph()}
  function end(m){s.dragging=false;s.pinned=wasPinned;physics.drag=null;s.suppressClick=moved;reheat();s.el.removeEventListener('pointermove',move);s.el.removeEventListener('pointerup',end);s.el.removeEventListener('pointercancel',end);if(s.el.hasPointerCapture(m.pointerId))s.el.releasePointerCapture(m.pointerId)}
  s.el.addEventListener('pointermove',move);s.el.addEventListener('pointerup',end);s.el.addEventListener('pointercancel',end);
 });
 var click=s.el.onclick;s.el.onclick=function(e){if(s.suppressClick){s.suppressClick=false;e.stopPropagation();return}click(e)};
 s.el.ondblclick=function(e){e.stopPropagation();s.pinned=!s.pinned;s.el.classList.toggle('pinned',s.pinned);reheat()};
