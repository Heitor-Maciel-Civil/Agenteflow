    if(b){var y=a.y+42;if(a.turn===b.turn)d+='<path class="w" d="M'+(a.x+88)+','+y+' L'+(b.x-8)+','+(b.y+42)+'" marker-end="url(#ar)"/>';
      else d+='<path class="w2" d="M'+(a.x+88)+','+y+' C'+(a.x+260)+','+y+' '+(b.x-170)+','+(b.y+42)+' '+(b.x-8)+','+(b.y+42)+'"/>'}
    if(a.satEl)d+='<path class="ws" d="M'+(a.x+42)+','+(a.y+86)+' L'+(a.x+42)+','+(a.y+138)+'"/>'}
  var last=steps[steps.length-1];
  if(working&&last){var gc=0;steps.forEach(function(s){if(s.turn===last.turn)gc++});var gx=PX+gc*CW,gy=PY+last.turn*RH;
    ghost.style.display='flex';ghost.style.left=gx+'px';ghost.style.top=gy+'px';d+='<path class="w" d="M'+(last.x+88)+','+(last.y+42)+' L'+(gx-8)+','+(gy+42)+'" marker-end="url(#ar)" stroke-dasharray="4 5"/>'}
  else ghost.style.display='none';
  wg.innerHTML=d;info();setStatus(working);
