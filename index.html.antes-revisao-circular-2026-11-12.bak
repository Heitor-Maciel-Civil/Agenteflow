   else{s.cx=(s.parent?s.parent.cx:0)+Math.cos(angle)*140;s.cy=(s.parent?s.parent.cy:0)+Math.sin(angle)*140}s.vx=s.vy=0}
 });
 drawGraph();document.getElementById('empty').style.display=steps.length?'none':'flex';info();setStatus(working);
