function info(){document.getElementById('info').textContent=(steps?steps.length:0)+' etapas'+(tokens?' · '+tokens.toLocaleString('pt-BR')+' tokens':'')+(model?' · '+model:'')}
function setStatus(on,m){document.getElementById('dot').className='dot'+(on?' on':'');document.getElementById('status').textContent=m||(on?'trabalhando':'ocioso')}
setInterval(function(){if(dirty&&!document.hidden)render()},250);
cv.addEventListener('pointerdown',function(e){if(e.target.closest('.n,.sat'))return;var sx=e.clientX,sy=e.clientY,ox=tx,oy=ty;cv.classList.add('drag');follow.checked=false;physics.fitPending=false;physics.navigationUntil=Infinity;
  function mv(m){tx=ox+m.clientX-sx;ty=oy+m.clientY-sy;queueViewport()}
  function up(){cv.classList.remove('drag');physics.navigationUntil=performance.now()+150;removeEventListener('pointermove',mv);removeEventListener('pointerup',up);removeEventListener('pointercancel',up)}
  addEventListener('pointermove',mv);addEventListener('pointerup',up);addEventListener('pointercancel',up)});
var zoomFrameQueued=false;
cv.addEventListener('pointermove',function(e){var r=cv.getBoundingClientRect(),x=(e.clientX-r.left-tx)/sc,y=(e.clientY-r.top-ty)/sc;gridHoverSpot.setAttribute('cx',x);gridHoverSpot.setAttribute('cy',y);gridHover.setAttribute('opacity','1');world.classList.add('cursor-active')});
cv.addEventListener('pointerleave',function(){gridHover.setAttribute('opacity','0');world.classList.remove('cursor-active')});
function queueViewport(){if(!zoomFrameQueued){zoomFrameQueued=true;requestAnimationFrame(function(){zoomFrameQueued=false;applyT(false)})}}
cv.addEventListener('wheel',function(e){e.preventDefault();follow.checked=false;physics.fitPending=false;physics.navigationUntil=performance.now()+220;var r=cv.getBoundingClientRect(),mx=e.clientX-r.left,my=e.clientY-r.top,ns=Math.max(.15,Math.min(2,sc*(e.deltaY<0?1.12:.89)));
  tx=mx-(mx-tx)*ns/sc;ty=my-(my-ty)*ns/sc;sc=ns;queueViewport()},{passive:false});
cv.addEventListener('click',function(){selected=null;paintSel();document.getElementById('pn').style.display='none'});
document.getElementById('px').onclick=function(){selected=null;paintSel();document.getElementById('pn').style.display='none'};
document.getElementById('fit').onclick=function(){follow.checked=false;fit()};
function connect(){if(es)es.close();resetAll();setStatus(false,'conectando…');
  es=new EventSource('/events?f='+encodeURIComponent(sel.value));
  es.onopen=function(){setStatus(false,'conectado')};
  es.addEventListener('file',function(e){resetAll();try{displayedSessionFile=JSON.parse(e.data);updateSessionTitle()}catch(x){}});
  es.onmessage=function(e){JSON.parse(e.data).forEach(function(l){try{handle(JSON.parse(l))}catch(x){}})};
  es.addEventListener('switch',function(){connect();loadList()});
  es.addEventListener('empty',function(){setStatus(false,'nenhuma sessão encontrada')});
  es.onerror=function(){setStatus(false,'reconectando…')}}
var sessionCatalog=[],displayedSessionFile='';
function activityAge(ms){var minutes=Math.max(0,Math.floor((Date.now()-ms)/60000));return minutes<1?'agora':minutes<60?'há '+minutes+' min':minutes<1440?'há '+Math.floor(minutes/60)+' h':'há '+Math.floor(minutes/1440)+' dias'}
function updateSessionTitle(){var current=sessionCatalog.find(function(s){return s.f===(displayedSessionFile||sel.value)}),button=document.getElementById('sessionsToggle');button.textContent=(current?current.title:'Selecionar sessão')+' ▾';button.title=current?current.title+' · Última atividade '+activityAge(current.m):'Selecionar sessão';document.title=current?current.title+' · Codex Flow':'Codex Flow'}
function chooseSession(file){sel.value=file;displayedSessionFile=file;document.getElementById('sessionPicker').hidden=true;document.getElementById('sessionsToggle').setAttribute('aria-expanded','false');connect();updateSessionTitle()}
function renderSessionList(){var list=document.getElementById('sessionList'),query=document.getElementById('sessionSearch').value.toLocaleLowerCase('pt-BR');list.textContent='';var auto=el('button','session-row','Acompanhar automaticamente a conversa mais recente');auto.onclick=function(){chooseSession('')};list.appendChild(auto);
 var filtered=sessionCatalog.filter(function(s){return [s.title,s.summary,s.lastRequest,s.cwd].join(' ').toLocaleLowerCase('pt-BR').includes(query)});
 filtered.forEach(function(s){var row=el('button','session-row'+(s.f===displayedSessionFile?' selected':''));row.appendChild(el('strong','',s.title||'Conversa sem título'));row.appendChild(el('small','',(s.f===displayedSessionFile?'Exibindo · ':'')+'Última atividade '+activityAge(s.m)+' · '+new Date(s.m).toLocaleString('pt-BR')));if(s.summary)row.appendChild(el('p','',s.summary));if(s.lastRequest&&s.lastRequest!==s.summary)row.appendChild(el('small','','Último pedido: '+s.lastRequest));if(s.cwd)row.appendChild(el('small','',s.cwd));row.onclick=function(){chooseSession(s.f)};list.appendChild(row)});if(!filtered.length)list.appendChild(el('p','','Nenhuma conversa encontrada.'));
}
function loadList(){fetch('/api/sessions').then(function(r){return r.json()}).then(function(l){sessionCatalog=l;var cur=sel.value;sel.length=1;l.forEach(function(s){var o=el('option','',s.title||s.f);o.value=s.f;sel.appendChild(o)});if(cur&&!l.some(function(s){return s.f===cur})){var saved=el('option','',cur);saved.value=cur;sel.appendChild(saved)}sel.value=cur;updateSessionTitle();renderSessionList()}).catch(function(){})}
// Agrupamento por turno e por assunto da ação, sem encadear consultas numa fila.
var originalPaint=paint,originalOut=out;
out=function(p){originalOut(p);var s=calls[p.call_id];if(!s)return;var j=parse(p.output),txt=String(s.out||'');
  if(j&&j.exit_code!=null&&j.exit_code!==0||j&&j.isError===true||/^(?:Error:|Error executing|Failed:|Traceback \(most recent call last\))/im.test(txt)){s.sat='err';s.satTxt='falha'}
