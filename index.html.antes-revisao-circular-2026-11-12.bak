addEventListener('resize',function(){if(follow.checked)fit();if(selected)placePopup(selected)});
addEventListener('keydown',function(e){if(e.key==='Escape'){selected=null;document.getElementById('pn').style.display='none';paintSel()}});
document.getElementById('foldHistory').onclick=function(){toggleHistory(!historyView.folded)};
