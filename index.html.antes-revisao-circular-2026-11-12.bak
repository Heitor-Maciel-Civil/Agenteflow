 var read=/readFile(?:Sync)?\(\s*["']([^"']+)["']/g;while((m=read.exec(source)))resource(m[1]);
 owner.resources=[];found.forEach(function(item){var picture=/\.(png|jpe?g|webp|gif|bmp)$/i.test(item.path),node=add('file',base(item.path),item.path,ts,{resourceOf:owner,resourcePath:item.path,resourceDiff:item.diff,resourceImage:picture});node.turn=owner.turn;node.agentOwner=owner.agentOwner;owner.resources.push(node)})}
function resourcePanel(s,pc){var heading=el('h3','',base(s.resourcePath));heading.prepend(iconFor(s.resourceImage?'img':'file'));pc.appendChild(heading);pc.appendChild(el('div','t',s.resourcePath));pc.appendChild(el('p','',resultSummary(s.resourceOf)));
 if(s.resourceDiff){pc.appendChild(el('h4','',nodeState(s.resourceOf)==='err'?'Alteração solicitada — execução falhou':'Diff registrado nesta etapa'));var diff=el('pre','resource-diff');s.resourceDiff.split('\n').forEach(function(line){diff.appendChild(el('div',line[0]==='+'?'diff-add':line[0]==='-'?'diff-remove':'',line))});pc.appendChild(diff);return}
 var file=s.agentOwner&&s.agentOwner.logFile||displayedSessionFile||sel.value,query='f='+encodeURIComponent(file)+'&path='+encodeURIComponent(s.resourcePath)+'&k='+encodeURIComponent(s.resourceOf.callKey||'');
 if(s.resourceImage){var img=el('img');img.alt=base(s.resourcePath);img.src='/api/image?'+query;img.onerror=function(){img.replaceWith(el('p','','Esta imagem não está mais disponível neste caminho.'))};pc.appendChild(img);return}
 pc.appendChild(el('p','','Sem diff registrado para esta leitura. A prévia abaixo mostra o arquivo atual.'));var preview=el('pre','','Carregando prévia…');pc.appendChild(preview);fetch('/api/resource?'+query).then(function(r){if(!r.ok)throw Error();return r.json()}).then(function(data){if(selected===s)preview.textContent=data.content+(data.truncated?'\n… prévia limitada':'' )}).catch(function(){if(selected===s)preview.textContent='Prévia indisponível. O arquivo pode ter sido movido, removido ou estar em formato binário.'})}
function out(p){var s=calls[p.call_id];if(!s)return;var o=p.output,txt='',code,im=null;
  if(Array.isArray(o)){o.forEach(function(c){if(c.image_url)im=c.image_url;else if(c.text)txt+=c.text+'\n'})}
  else{var j=parse(o);if(j&&typeof j==='object'){txt=j.output!=null?j.output:JSON.stringify(j);if(j.metadata&&j.metadata.exit_code!=null)code=j.metadata.exit_code}else txt=String(o==null?'':o)}
  if(code==null){var m=/exit code:?\s*(-?\d+)/i.exec(txt);if(m)code=+m[1]}
  var bad=(code!=null&&code!==0)||(s.kind==='edit'&&/^\s*(error|erro|failed|falha)/i.test(txt));
  s.out=txt;if(im)s.img=im;if(s.sat){s.sat=bad?'err':'ok';s.satTxt=code!=null?'exit '+code:(bad?'falhou':'ok')}
  dirty=true;if(selected&&(selected===s||selected.resourceOf===s))panel(selected)}
function handle(o){var t=o.type,p=o.payload||{},ts=o.timestamp,ty=p.type||'';
  if(t==='session_meta'||t==='turn_context'){model=p.model||model;if(p.cwd)sessionCwd=p.cwd;return}
  if(t==='response_item'){
    if(ty==='message'){var parts=p.content||[],im=null,txt=parts.filter(function(c){return c.text&&c.text.charAt(0)!=='<'}).map(function(c){return c.text}).join('\n').trim();
      parts.forEach(function(c){if(c.image_url)im=c.image_url});
      if(p.role==='user'){if(!txt&&!im)return;add('user',txt||'(imagem)',txt,ts,{img:im})}
      else if(p.role==='assistant'&&txt)add('ans',txt,txt,ts)}
    else if(ty==='reasoning'){var r=(p.summary||[]).map(function(x){return x.text||''}).join('\n').trim();
      lastThink=add('think',r,r||'(o Codex não gravou o texto deste raciocínio)',ts,{empty:!r})}
    else if(/_call$/.test(ty))call(p,ts);else if(/call_output$/.test(ty))out(p)}
  else if(t==='event_msg'){
    if(ty==='agent_reasoning'&&p.text&&lastThink&&lastThink.empty){lastThink.detail=p.text;lastThink.sub=one(p.text,34);lastThink.empty=false;dirty=true}
    if(ty==='token_count'&&p.info&&p.info.total_token_usage)tokens=p.info.total_token_usage.total_tokens||tokens;
    if(ty==='task_started'){working=true;dirty=true}if(ty==='task_complete'||ty==='turn_aborted'){working=false;dirty=true}}}
function ensure(s){if(s.el)return;var k=K[s.kind];
  var e=el('div','n '+s.kind);e.style.setProperty('--c',k.c);e.appendChild(iconFor(s.kind==='file'&&s.resourceImage?'img':s.kind));
  var l=el('div','lb');l.appendChild(el('b','',k.t));s.subEl=el('span','',s.sub);l.appendChild(s.subEl);e.appendChild(l);
  e.onclick=function(ev){ev.stopPropagation();selected=s;panel(s);reheat();paintSel()};nodesEl.appendChild(e);s.el=e;
  if(s.sat){var c=el('div','sat');c.appendChild(el('i','',''));s.satLb=el('small','');c.appendChild(s.satLb);c.onclick=e.onclick;nodesEl.appendChild(c);s.satEl=c}}
function paint(s){s.subEl.textContent=s.sub;
  if(s.satEl){s.satEl.className='sat '+s.sat;s.satEl.firstChild.textContent=s.sat==='ok'?'✔':s.sat==='err'?'✖':'…';s.satLb.textContent=s.sat==='pending'?'executando':s.satTxt}}
function paintSel(){steps.forEach(function(s){if(s.el)s.el.classList.toggle('sel',s===selected)})}
function panel(s){var pc=document.getElementById('pc');pc.textContent='';var k=K[s.kind];
  if(s.kind==='file'){resourcePanel(s,pc);document.getElementById('pn').style.display='block';placePopup(s);return}
  var heading=el('h3','',s.kind==='agent'?agentAssignment(s):k.t);heading.prepend(iconFor(s.kind));pc.appendChild(heading);pc.appendChild(el('div','t',hm(s.ts)+' · turno '+(s.turn+1)));
  function sec(h,t){pc.appendChild(el('h4','',h));pc.appendChild(el('pre','',t))}
  if(/^(tool|edit|web|img)$/.test(s.kind)){sec('O que fez',actionSummary(s));sec('Resultado',resultSummary(s))}else if(s.kind==='think')sec('Atividade observada',activitySummary(s));else if(s.detail)sec(s.kind==='user'?'Pedido':'Conteúdo',s.detail);
  if(s.out!=null&&!/^(tool|edit|web|img|think)$/.test(s.kind))sec('Resultado'+(s.satTxt?' ('+s.satTxt+')':''),s.out.length>8000?s.out.slice(0,8000)+'\n…':s.out||'(sem saída)');
  if(s.img){pc.appendChild(el('h4','','Imagem'));var im=el('img');im.src=s.kind==='img'&&s.imagePath?'/api/image?f='+encodeURIComponent(s.agentOwner&&s.agentOwner.logFile||displayedSessionFile||sel.value)+'&path='+encodeURIComponent(s.imagePath)+'&k='+encodeURIComponent(s.callKey||''):s.img;pc.appendChild(im)}
  document.getElementById('pn').style.display='block';placePopup(s)}
function placePopup(s){if(!s||!Number.isFinite(s.cx))return;var p=document.getElementById('pn');if(p.style.display!=='block')return;
 var r=cv.getBoundingClientRect(),x=r.left+tx+s.cx*sc,y=r.top+ty+s.cy*sc,w=p.offsetWidth,h=p.offsetHeight;
 var left=x+s.size*sc/2+18;if(left+w>r.right-12)left=x-s.size*sc/2-w-18;
 p.style.left=Math.max(r.left+12,Math.min(left,r.right-w-12))+'px';p.style.top=Math.max(r.top+12,Math.min(y-30,r.bottom-h-12))+'px';}
function zoomSpacing(z){return 1+Math.max(0,Math.min(1.5,z-.65))*.3}
function updateZoomLabels(){world.classList.toggle('zoom-medium',sc>=.35);world.classList.toggle('zoom-types',sc>=.85);world.classList.toggle('zoom-details',sc>=1.75);world.classList.toggle('overview',sc<.35);world.classList.toggle('grid-coarse',sc<.35);world.classList.toggle('grid-medium',sc>=.35&&sc<=1.2);world.classList.toggle('grid-fine',sc>1.2);var gridSize=sc<.35?48:sc<=1.2?24:18;[dotGlyphPattern,brightGlyphPattern].forEach(function(pattern){pattern.setAttribute('width',gridSize);pattern.setAttribute('height',gridSize)});gridHoverSpot.setAttribute('r',145/sc);world.style.setProperty('--zoom',sc);
 if(typeof physics!=='undefined'&&physics){var spacing=zoomSpacing(sc);if(Math.abs((physics.targetSpacing||1)-spacing)>.015){physics.targetSpacing=spacing;physics.zoomLayoutPending=true}}
 if(typeof physics!=='undefined'&&physics&&physics.overview!==(sc<.35)){physics.overview=sc<.35;physics.zoomLayoutPending=true;if(selected&&selected.kind!=='user'&&physics.overview){selected=null;document.getElementById('pn').style.display='none'}}}
function applyT(anim){world.classList.toggle('anim',!!anim);world.style.transform='translate('+tx+'px,'+ty+'px) scale('+sc+')';
  updateZoomLabels();if(selected)placePopup(selected);if(typeof historyView!=='undefined'&&historyView&&steps&&steps.length&&Number.isFinite(steps[0].cx))drawGraph()}
function focus(s){sc=Math.min(sc,1)||1;tx=cv.clientWidth*.55-(s.x+42)*sc;ty=cv.clientHeight*.42-(s.y+42)*sc;applyT(true)}
function fit(){if(!steps.length)return;var x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  steps.forEach(function(s){x0=Math.min(x0,s.x);y0=Math.min(y0,s.y-60);x1=Math.max(x1,s.x+84);y1=Math.max(y1,s.y+210)});
  sc=Math.min(1,cv.clientWidth/(x1-x0+160),cv.clientHeight/(y1-y0+120));tx=(cv.clientWidth-(x1-x0)*sc)/2-x0*sc;ty=(cv.clientHeight-(y1-y0)*sc)/2-y0*sc;applyT(true)}
function render(){dirty=false;var cnt={},d='';document.getElementById('empty').style.display=steps.length?'none':'flex';
  steps.forEach(function(s){cnt[s.turn]=cnt[s.turn]||0;s.col=cnt[s.turn]++;s.x=PX+s.col*CW;s.y=PY+s.turn*RH;ensure(s);paint(s);
    s.el.style.left=s.x+'px';s.el.style.top=s.y+'px';if(s.satEl){s.satEl.style.left=(s.x+19)+'px';s.satEl.style.top=(s.y+140)+'px'}
    if(!rl[s.turn]){rl[s.turn]=el('div','rl','Turno '+(s.turn+1));nodesEl.appendChild(rl[s.turn])}
    rl[s.turn].style.left=PX+'px';rl[s.turn].style.top=(PY+s.turn*RH-86)+'px'});
  paintSel();
