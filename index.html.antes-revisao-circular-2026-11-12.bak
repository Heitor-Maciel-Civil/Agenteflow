}
function agentColor(s){var agents=steps.filter(function(a){return a.kind==='agent'}),i=Math.max(0,agents.indexOf(s));return ['#e5e5e5','#c8c8c8','#aaaaaa','#8c8c8c'][i%4]}
function importanceTone(level){var tones=['#707070','#929292','#b8b8b8','#eeeeee'];return tones[Math.max(0,Math.min(3,Math.floor(Number(level)||0)))]}
function commandColor(s){return importanceTone(nodeLevel(s))}
function linkColor(e){if(e.root)return '#d0d0d0';if(e.b.kind==='agent')return agentColor(e.b);if(e.b.agentOwner)return agentColor(e.b.agentOwner);if(e.b.kind==='tool')return commandColor(e.b);return ({ans:'#c8c8c8',edit:'#b8b8b8',think:'#a0a0a0',web:'#d0d0d0',img:'#e0e0e0'})[e.b.kind]||'#a8a8a8'}
function orbitOutset(s){var links=physics.degree&&physics.degree.get(s)||0,root=requestRoot(s),area=root&&root.areaRadius||300;return Math.round(18+nodeLevel(s)*8+Math.min(28,Math.sqrt(links)*8)+Math.min(28,Math.max(0,area-300)*.04))}
function attractionRadius(anchor,level){var root=requestRoot(anchor),area=root&&root.areaRadius||300,links=physics.degree&&physics.degree.get(anchor)||0,tier=Math.max(1,Math.min(3,Math.floor(Number(level)||1)));return Math.round(105+tier*62+Math.min(110,Math.max(0,area-300)*.08)+Math.min(45,Math.sqrt(links)*5))}
