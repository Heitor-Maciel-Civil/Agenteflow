 ghost.style.display='none';var processing=processingNode(visible);visible.forEach(function(s){s.el.classList.toggle('processing',s===processing)});if(selected)placePopup(selected);
}
function processingNode(visible){if(!working||!steps.length)return null;var candidate=null;for(var i=steps.length-1;i>=0;i--){var s=steps[i];if(s.turn!==turn)continue;if(!candidate)candidate=s;if(s.sat==='pending'){candidate=s;break}}if(!candidate)return null;if(visible.has(candidate))return candidate;var parent=candidate.parent||candidate.treeRoot;while(parent){if(visible.has(parent))return parent;parent=parent.parent}return null}
render=function(){dirty=false;physics.edges=graphEdges();physics.degree=new Map();physics.edges.forEach(function(e){physics.degree.set(e.a,(physics.degree.get(e.a)||0)+1);physics.degree.set(e.b,(physics.degree.get(e.b)||0)+1)});requestAreas();physics.processing=processingNode(new Set(steps));var rootCount=0;
