}
function separateStraightLinks(sim,heat){var index=spatialGrid(sim,180),outgoing=new Map();physics.edges.forEach(function(e){if(!outgoing.has(e.a))outgoing.set(e.a,[]);outgoing.get(e.a).push(e)});
 physics.edges.forEach(function(e){if(isFolded(e.a)||isFolded(e.b)||physics.overview&&!e.root)return;var a=e.a,b=e.b,dx=b.cx-a.cx,dy=b.cy-a.cy,len2=dx*dx+dy*dy;if(len2<1)return;var len=Math.sqrt(len2),neighbors=new Set();for(var i=1;i<5;i++)gridNear(index,a.cx+dx*i/5,a.cy+dy*i/5).forEach(function(s){if(neighbors.size<32&&s!==a&&s!==b)neighbors.add(s)});
