function syncGlyphText(group,index,pathId,length,className){var text=group.children[index];if(!text){text=document.createElementNS('http://www.w3.org/2000/svg','text');var textPath=document.createElementNS('http://www.w3.org/2000/svg','textPath');text.appendChild(textPath);group.appendChild(text)}
 var textPath=text.firstChild;text.setAttribute('class',className);text.setAttribute('aria-hidden','true');text.style.fill='';textPath.setAttribute('href','#'+pathId);textPath.setAttribute('startOffset','0');textPath.setAttribute('textLength',Math.max(1,length));textPath.setAttribute('lengthAdjust','spacingAndGlyphs');textPath.textContent=edgeGlyphRun(length);return text}
function updateAttractionField(){if(!forceField)return;var anchor=selected&&!isFolded(selected)?selected:null;
 if(!anchor){while(forceField.children.length)forceField.lastChild.remove();return}
 for(var i=1;i<=3;i++){var index=(i-1)*2,ring=forceField.children[index];if(!ring){ring=document.createElementNS('http://www.w3.org/2000/svg','path');forceField.appendChild(ring)}
  var radius=attractionRadius(anchor,i),sides=8;ring.setAttribute('id','force-ring-'+i);ring.setAttribute('class','force-ring force-level-'+i);ring.setAttribute('d',orbitGlyphPath(anchor.cx,anchor.cy,radius,sides));
  var perimeter=2*sides*radius*Math.sin(Math.PI/sides);syncGlyphText(forceField,index+1,'force-ring-'+i,perimeter,'force-glyph force-level-'+i)}
}
var historyView={folded:true,cutoff:-Infinity,anchor:null,element:null,focusRoot:null};
function isFolded(s){var request=s.kind==='user'?s:s.treeRoot||steps.find(function(r){return r.kind==='user'&&r.turn===s.turn});var primary=request&&request.subrequestOf||request;return !!historyView&&historyView.folded&&(primary?primary.turn:s.turn)<=historyView.cutoff}
function updateHistory(){var roots=steps.filter(function(s){return s.kind==='user'&&!s.subrequestOf});historyView.cutoff=roots.length>2?roots[roots.length-3].turn:-Infinity;
 if(!historyView.element){var h=el('div','n user history');h.appendChild(iconFor('user'));h.tabIndex=0;h.setAttribute('role','button');h.setAttribute('aria-label','Expandir pedidos antigos');h.onclick=function(e){e.stopPropagation();toggleHistory(false)};h.onkeydown=function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleHistory(false)}};nodesEl.appendChild(h);historyView.element=h}
 if(!historyView.element.isConnected)nodesEl.appendChild(historyView.element);
 var first=roots[roots.length-2];historyView.element.style.display=historyView.folded&&roots.length>2?'flex':'none';
 historyView.anchor=historyView.folded&&roots.length>2?{cx:first.cx-220,cy:first.cy-300,x:first.cx-278,y:first.cy-358,size:116}:null;
 if(historyView.anchor){historyView.element.style.left=historyView.anchor.x+'px';historyView.element.style.top=historyView.anchor.y+'px'}
 document.getElementById('foldHistory').textContent=historyView.folded?'Expandir antigos':'Agrupar antigos';document.getElementById('foldHistory').setAttribute('aria-pressed',String(historyView.folded));
 if(selected&&isFolded(selected)){selected=null;document.getElementById('pn').style.display='none'}
}
function toggleHistory(value){historyView.folded=value;drawGraph();reheat();fit()}
function focusedRequest(){if(sc<1.35)return null;if(selected&&!isFolded(selected))return selected.treeRoot||selected;
 var x=(cv.clientWidth/2-tx)/sc,y=(cv.clientHeight/2-ty)/sc,best=null,d=Infinity;steps.forEach(function(s){if(s.kind!=='user'||isFolded(s))return;var v=Math.hypot(s.cx-x,s.cy-y);if(v<d){d=v;best=s}});var old=historyView.focusRoot;if(old&&!isFolded(old)&&Math.hypot(old.cx-x,old.cy-y)<d*1.3+80)return old;return best}
