 sim.forEach(function(s){var home=requestRoot(s);if(!home||s===home||s.pinned||s.dragging)return;var dx=s.cx-home.cx,dy=s.cy-home.cy,d=Math.max(1,Math.hypot(dx,dy)),limit=(home.areaRadius||300)*spacing;if(d>limit){var pull=Math.min(3,(d-limit)*.015)*heat;s.vx-=dx/d*pull;s.vy-=dy/d*pull}});
